FROM php:8.2-cli
# Proper PHP 8.2 lab target for php2shell (session.upload_progress + session_start)
COPY p82.php /var/www/html/p.php
RUN echo '<?php' > /var/www/html/index.php && echo 'session_start();' >> /var/www/html/index.php && echo 'echo "php82-lab-ok\n";' >> /var/www/html/index.php && \
    mkdir -p /out && chmod 777 /out && \
    sed -i 's/;memory_limit = .*/memory_limit = 256M/' /usr/local/etc/php/php.ini && \
    sed -i 's/;post_max_size = .*/post_max_size = 64M/' /usr/local/etc/php/php.ini && \
    sed -i 's/;upload_max_filesize = .*/upload_max_filesize = 32M/' /usr/local/etc/php/php.ini && \
    sed -i 's/;max_file_uploads = .*/max_file_uploads = 2000/' /usr/local/etc/php/php.ini && \
    sed -i 's/;display_errors = .*/display_errors = On/' /usr/local/etc/php/php.ini && \
    sed -i 's/;session.upload_progress.enabled = .*/session.upload_progress.enabled = 1/' /usr/local/etc/php/php.ini
EXPOSE 80
CMD ["php", "-S", "0.0.0.0:80", "-t", "/var/www/html"]
