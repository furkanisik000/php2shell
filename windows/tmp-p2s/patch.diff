+	if (Z_TYPE_P(a) == IS_ARRAY) {

+		return Z_ARRVAL_P(a) != Z_ARRVAL_P(b)

+			&& zend_hash_compare(Z_ARRVAL_P(a), Z_ARRVAL_P(b), sccp_values_differ, 1) != 0;

